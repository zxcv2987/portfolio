---
import type { MetaItem } from '../../lib/detail';

interface Props {
	items: MetaItem[];
	class?: string;
}

const { items, class: className } = Astro.props;
---

<dl
	class:list={[
		'm-0 grid grid-cols-[5.5rem_1fr] gap-x-4 gap-y-2 p-0 text-sm sm:grid-cols-[7rem_1fr]',
		className,
	]}
>
	{
		items.map((item) => (
			<>
				<dt class="font-medium text-muted">{item.label}</dt>
				<dd class="m-0">{item.value}</dd>
			</>
		))
	}
</dl>
