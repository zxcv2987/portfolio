---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

export interface ExtraSection {
	id: string;
	title: string;
}

interface Props {
	headings: Heading[];
	/** 본문 뒤에 붙는 도식 섹션처럼, 마크다운 헤딩이 아닌 항목을 목차에 포함한다. */
	extra?: ExtraSection[];
	class?: string;
}

const { headings, extra = [], class: className } = Astro.props;
const items = [
	...headings
		.filter((heading) => heading.depth === 2)
		.map((heading) => ({ href: `#${heading.slug}`, text: heading.text })),
	...extra.map((section) => ({ href: `#${section.id}`, text: section.title })),
];
---

{
	items.length > 0 && (
		<details class:list={['mt-10 border border-border-subtle', className]}>
			<summary class="flex cursor-pointer list-none items-center gap-2 px-4 py-3 text-sm font-medium select-none">
				<span aria-hidden="true" class="text-muted">▸</span>
				목차
			</summary>
			<nav aria-label="문서 목차" class="border-t border-border-subtle px-4 py-3">
				<ol class="m-0 list-none space-y-1 p-0 text-sm">
					{items.map((item) => (
						<li>
							<a
								href={item.href}
								class="text-muted no-underline hover:text-foreground hover:underline"
							>
								{item.text}
							</a>
						</li>
					))}
				</ol>
			</nav>
		</details>
	)
}

<style>
	details[open] > summary > span[aria-hidden] {
		transform: rotate(90deg);
	}
	summary > span[aria-hidden] {
		display: inline-block;
		transition: transform 160ms ease;
	}
</style>
