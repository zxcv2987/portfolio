---
import Prose from '../Prose.astro';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<Prose
	class:list={[
		'[&>h1:first-child]:hidden',
		'[&_h2]:mt-12! [&_h2]:border-b [&_h2]:border-border-subtle [&_h2]:pb-3 [&_h2]:text-xl [&_h2]:tracking-tight sm:[&_h2]:text-2xl',
		'[&_h3]:mt-8! [&_h3]:text-base [&_h3]:tracking-tight sm:[&_h3]:text-lg',
		'[&_blockquote]:border-l-2 [&_blockquote]:border-border-subtle [&_blockquote]:pl-4 [&_blockquote]:text-muted',
		'[&_hr]:my-10! [&_hr]:border-border-subtle',
		className,
	]}
>
	<slot />
</Prose>
