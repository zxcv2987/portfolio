---
import SectionTitle from '../SectionTitle.astro';

interface Props {
	id: string;
	title: string;
	class?: string;
}

const { id, title, class: className } = Astro.props;
---

<section
	id={id}
	aria-labelledby={`${id}-heading`}
	class:list={['mt-16 scroll-mt-8 sm:mt-20', className]}
>
	<SectionTitle id={`${id}-heading`}>{title}</SectionTitle>
	<div class="mt-6">
		<slot />
	</div>
</section>
