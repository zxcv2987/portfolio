---
import type { LinkItem } from '../../lib/detail';

interface Props {
	items: LinkItem[];
	class?: string;
}

const { items, class: className } = Astro.props;
---

<ul class:list={['m-0 list-none space-y-2 p-0', className]}>
	{
		items.map((item) => (
			<li>
				<a
					href={item.href}
					target={item.external ? '_blank' : undefined}
					rel={item.external ? 'noopener noreferrer' : undefined}
				>
					{item.label}
					{item.external && <span aria-hidden="true" class="text-muted">↗</span>}
				</a>
			</li>
		))
	}
</ul>
