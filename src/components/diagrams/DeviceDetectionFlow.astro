---
/**
 * device-detection.md "구현" 섹션의 5단계 판별 과정을 보여주는 흐름 다이어그램.
 * User-Agent 우선 분류 → 화면·뷰포트 크기 → 터치 지원 → WebGL GPU 보조 신호 → 최종 분류
 */
interface Props {
	class?: string;
}

const { class: className } = Astro.props;

interface Step {
	title: string;
	description: string;
	note?: string;
	final?: boolean;
}

const steps: Step[] = [
	{
		title: 'User-Agent 우선 분류',
		description:
			'기존 User-Agent에서 명확하게 확인할 수 있는 환경을 먼저 분류합니다.',
	},
	{
		title: '화면·뷰포트 크기',
		description:
			'화면과 뷰포트 크기로 휴대형 기기 가능성을 확인합니다.',
	},
	{
		title: '터치 지원',
		description:
			'터치 이벤트 지원 여부와 최대 터치 포인트를 확인합니다.',
	},
	{
		title: 'WebGL GPU 정보',
		description:
			'필요한 경우 WebGL에서 확인 가능한 GPU 정보를 보조 신호로 사용합니다.',
		note: '브라우저와 개인정보 보호 설정에 따라 제한될 수 있어 유일한 기준으로 사용하지 않았습니다.',
	},
	{
		title: '최종 분류',
		description:
			'여러 조건이 함께 충족될 때만 태블릿 또는 모바일 환경으로 분류합니다.',
		final: true,
	},
];
---

<div class:list={['flex w-full flex-col', className]}>
	{
		steps.map((step, i) => (
			<>
				{i > 0 && (
					<div
						aria-hidden="true"
						class="relative mx-auto h-8 w-px shrink-0 bg-border-subtle"
					>
						<span class="absolute -bottom-0.5 left-1/2 h-0 w-0 -translate-x-1/2 border-x-4 border-t-[5px] border-x-transparent border-t-muted" />
					</div>
				)}
				<div
					class:list={[
						'mx-auto w-full max-w-md rounded-lg border px-4 py-3.5 sm:px-5',
						step.final
							? 'border-foreground bg-foreground text-background'
							: 'border-border-subtle bg-background',
					]}
				>
					<div class="grid grid-cols-[auto_1fr] items-baseline gap-x-3">
						<span
							class:list={[
								'text-xs font-semibold tabular-nums',
								step.final ? 'text-background/60' : 'text-muted',
							]}
						>
							{String(i + 1).padStart(2, '0')}
						</span>
						<h3 class="text-sm font-bold tracking-tight">{step.title}</h3>
						<p
							class:list={[
								'col-start-2 mt-1 text-sm leading-relaxed',
								step.final ? 'text-background/70' : 'text-muted',
							]}
						>
							{step.description}
						</p>
						{step.note && (
							<p class="col-start-2 mt-2 text-xs leading-relaxed">
								* {step.note}
							</p>
						)}
					</div>
				</div>
			</>
		))
	}
</div>
