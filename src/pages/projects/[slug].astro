---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DetailSection from '../../components/detail/DetailSection.astro';
import MetaList from '../../components/detail/MetaList.astro';
import LabeledList from '../../components/detail/LabeledList.astro';
import RelatedLinks from '../../components/detail/RelatedLinks.astro';
import PrevNextNav from '../../components/detail/PrevNextNav.astro';
import ArticleBody from '../../components/detail/ArticleBody.astro';
import TableOfContents from '../../components/detail/TableOfContents.astro';
import DongleStructure from '../../components/diagrams/DongleStructure.astro';
import {
	isLiveService,
	isUnconfirmed,
	linkItemsFromRecord,
	pickMeta,
	serviceLink,
	type LinkItem,
	type MetaItem,
} from '../../lib/detail';
import { site } from '../../config/site';

export async function getStaticPaths() {
	const entries = (await getCollection('projects')).sort(
		(a, b) => a.data.order - b.data.order,
	);

	return entries.map((entry, index) => {
		const toLink = (item: (typeof entries)[number]): LinkItem => ({
			href: `/projects/${item.data.slug || item.id}`,
			label: item.data.title,
		});

		return {
			params: { slug: entry.data.slug || entry.id },
			props: {
				entry,
				prev: index > 0 ? toLink(entries[index - 1]!) : undefined,
				next:
					index < entries.length - 1 ? toLink(entries[index + 1]!) : undefined,
			},
		};
	});
}

interface Props {
	entry: CollectionEntry<'projects'>;
	prev?: LinkItem;
	next?: LinkItem;
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const data = entry.data;
const slug = data.slug || entry.id;

const meta: MetaItem[] = [
	pickMeta('분류', data.category),
	pickMeta('기간', data.period),
	pickMeta('역할', data.role),
	pickMeta('팀', data.team),
	pickMeta('담당 범위', data.contribution),
].filter((item): item is MetaItem => item !== null);

const showLiveService = isLiveService(data);
const primaryServiceHref = showLiveService ? serviceLink(data) : null;
const remainingLinks = data.links
	? Object.fromEntries(
			Object.entries(data.links).filter(
				([key]) => !(showLiveService && key === 'service'),
			),
		)
	: {};
const relatedLinks = linkItemsFromRecord(remainingLinks);
---

<Layout title={`${data.title} — ${site.name}`} description={isUnconfirmed(data.summary) ? undefined : data.summary}>
	<header>
		<p class="m-0 text-sm font-medium text-muted">Projects</p>
		<h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">
			{data.title}
			{showLiveService && (
				<span class="ml-2 align-middle rounded-full border border-border-subtle px-2 py-0.5 text-xs font-medium text-muted">
					운영 중
				</span>
			)}
		</h1>
	</header>

	<DetailSection id="overview" title="요약">
		<div class="flex flex-col gap-6">
			<MetaList items={meta} />
			{
				!isUnconfirmed(data.summary) && (
					<p class="m-0 text-base leading-relaxed">{data.summary}</p>
				)
			}
			{
				primaryServiceHref && (
					<p class="m-0">
						<a
							href={primaryServiceHref}
							target="_blank"
							rel="noopener noreferrer"
							class="font-medium no-underline hover:underline"
						>
							지금 서비스 사용해보기 <span aria-hidden="true">→</span>
						</a>
					</p>
				)
			}
			{data.highlights.length > 0 && (
				<LabeledList label="하이라이트" items={data.highlights} />
			)}
			{data.tech.length > 0 && (
				<LabeledList label="기술 스택" items={data.tech} variant="pill" />
			)}
		</div>
	</DetailSection>

	<TableOfContents headings={headings} />

	{
		slug === 'dongle' && (
			<DetailSection id="structure-diagram" title="서비스 구조">
				<DongleStructure />
			</DetailSection>
		)
	}

	<ArticleBody class="mt-16 sm:mt-20">
		<Content />
	</ArticleBody>

	<PrevNextNav prev={prev} next={next} />

	{
		relatedLinks.length > 0 && (
			<DetailSection id="links" title="관련 링크">
				<RelatedLinks items={relatedLinks} />
			</DetailSection>
		)
	}
</Layout>
