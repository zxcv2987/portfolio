---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Prose from '../../components/Prose.astro';
import { site } from '../../config/site';
import { isUnconfirmed, linkItemsFromRecord } from '../../lib/detail';

const entries = (await getCollection('projects')).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<Layout title={`Projects — ${site.name}`}>
	<header>
		<h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Projects</h1>
		<p class="mt-3 text-sm text-muted">
			팀 프로젝트와 개인 프로젝트를 함께 정리했습니다 (총 {entries.length}건).
		</p>
	</header>

	<div class="mt-10 space-y-10">
		{
			entries.map((entry) => {
				const meta = [entry.data.category, entry.data.period]
					.filter((part) => !isUnconfirmed(part))
					.join(' · ');
				const links = entry.data.links
					? linkItemsFromRecord(entry.data.links)
					: [];

				return (
					<article>
						<h2 class="text-lg font-bold tracking-tight">
							<a
								href={`/projects/${entry.data.slug}`}
								class="no-underline hover:underline"
							>
								{entry.data.title}
							</a>
						</h2>
						{meta && <p class="mt-1 text-sm text-muted">{meta}</p>}
						<Prose class="mt-2">
							<p>{entry.data.summary}</p>
						</Prose>
						{links.length > 0 && (
							<ul class="mt-3 flex list-none flex-wrap gap-x-4 gap-y-1 p-0 text-sm">
								{links.map((link) => (
									<li>
										<a
											href={link.href}
											rel={link.external ? 'noopener noreferrer' : undefined}
											target={link.external ? '_blank' : undefined}
											class="no-underline hover:underline"
										>
											{link.label}
										</a>
									</li>
								))}
							</ul>
						)}
					</article>
				);
			})
		}
	</div>
</Layout>
