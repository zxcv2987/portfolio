---
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';
---

<Layout title={`페이지를 찾을 수 없음 — ${site.name}`}>
	<div class="py-16 text-center sm:py-24">
		<p class="text-sm font-medium text-muted">404</p>
		<h1 class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">
			요청하신 페이지를 찾을 수 없습니다
		</h1>
		<p class="mt-4 text-base text-muted">
			주소가 바뀌었거나 더 이상 존재하지 않는 페이지일 수 있습니다.
		</p>
		<p class="mt-8">
			<a href="/" class="no-underline hover:underline">홈으로 돌아가기</a>
		</p>
	</div>
</Layout>
