---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { site } from '../../config/site';
import { isUnconfirmed } from '../../lib/detail';

const entries = (await getCollection('experience')).sort(
	(a, b) => a.data.order - b.data.order,
);
const caseStudiesByHref = new Map(
	(await getCollection('case-studies')).map((entry) => [
		`/case-studies/${entry.data.slug}`,
		entry,
	]),
);
---

<Layout
	title={`Experience — ${site.name}`}
	description={`${site.name} ${site.role}의 회사 경력입니다. 각 경력에서 담당한 문제와 그 판단을 확인할 수 있는 대표 사례를 함께 정리했습니다.`}
>
	<header>
		<h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Experience</h1>
		<p class="mt-3 text-sm text-muted">
			회사 경력에서 담당한 문제와, 그 판단을 확인할 수 있는 대표 사례입니다.
		</p>
		<a href="/resume" class="mt-4 inline-flex min-h-11 items-center text-sm font-medium no-underline hover:underline">
			이력서에서 핵심 성과 보기
		</a>
	</header>

	<div class="mt-10 space-y-10">
		{
			entries.map((entry) => {
				const meta = [
					entry.data.role,
					entry.data.employment_type,
					isUnconfirmed(entry.data.period) ? undefined : entry.data.period,
				]
					.filter((part) => part !== undefined)
					.join(' · ');
				const relatedCaseStudies = (entry.data.case_studies ?? [])
					.map((href) => caseStudiesByHref.get(href))
					.filter((caseStudy) => caseStudy !== undefined);

				return (
					<article class="border-t border-border-subtle pt-8 first:border-t-0 first:pt-0">
						<h2 class="text-lg font-bold tracking-tight">
							{entry.data.company}
						</h2>
						<p class="mt-1 text-sm text-muted">{meta}</p>
						{relatedCaseStudies.length > 0 && (
							<ul class="mt-5 list-none space-y-5 p-0">
								{relatedCaseStudies.map((caseStudy) => (
									<li>
										<a
											href={`/case-studies/${caseStudy.data.slug}`}
											class="font-medium no-underline hover:underline"
										>
											{caseStudy.data.title}
										</a>
										<p class="mt-1 text-sm leading-relaxed text-muted">
											{caseStudy.data.summary}
										</p>
										{
											caseStudy.data.highlights.length > 0 && (
												<p class="mt-2 text-sm font-medium">
													{caseStudy.data.highlights.find((item) => !isUnconfirmed(item))}
												</p>
											)
										}
									</li>
								))}
							</ul>
						)}
					</article>
				);
			})
		}
	</div>
</Layout>
