---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DetailSection from '../../components/detail/DetailSection.astro';
import MetaList from '../../components/detail/MetaList.astro';
import LabeledList from '../../components/detail/LabeledList.astro';
import RelatedLinks from '../../components/detail/RelatedLinks.astro';
import PrevNextNav from '../../components/detail/PrevNextNav.astro';
import ArticleBody from '../../components/detail/ArticleBody.astro';
import TableOfContents, {
	type ExtraSection,
} from '../../components/detail/TableOfContents.astro';
import AdminRenewalProcess from '../../components/diagrams/AdminRenewalProcess.astro';
import MigrationBoundary from '../../components/diagrams/MigrationBoundary.astro';
import RealtimeBoundary from '../../components/diagrams/RealtimeBoundary.astro';
import DeviceDetectionFlow from '../../components/diagrams/DeviceDetectionFlow.astro';
import {
	isUnconfirmed,
	pickMeta,
	type LinkItem,
	type MetaItem,
} from '../../lib/detail';
import { site } from '../../config/site';

export async function getStaticPaths() {
	const entries = (await getCollection('case-studies')).sort(
		(a, b) => a.data.order - b.data.order,
	);
	const experiences = await getCollection('experience');

	return entries.map((entry, index) => {
		const slug = entry.data.slug || entry.id;
		const parent = experiences.find((item) =>
			(item.data.case_studies ?? []).includes(`/case-studies/${slug}`),
		);
		const toLink = (item: (typeof entries)[number]) => ({
			href: `/case-studies/${item.data.slug || item.id}`,
			label: item.data.title,
		});

		return {
			params: { slug },
			props: {
				entry,
				parentLink: parent
					? { href: `/experience/${parent.id}`, label: `소속 경력 — ${parent.data.company}` }
					: null,
				prev: index > 0 ? toLink(entries[index - 1]!) : undefined,
				next:
					index < entries.length - 1 ? toLink(entries[index + 1]!) : undefined,
			},
		};
	});
}

interface Props {
	entry: CollectionEntry<'case-studies'>;
	parentLink: LinkItem | null;
	prev?: LinkItem;
	next?: LinkItem;
}

const { entry, parentLink, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const data = entry.data;
const slug = data.slug || entry.id;

const meta: MetaItem[] = [
	pickMeta('분류', data.category),
	pickMeta('회사', data.company),
	pickMeta('기간', data.period),
	pickMeta('역할', data.role),
].filter((item): item is MetaItem => item !== null);

const relatedLinks: LinkItem[] = parentLink ? [parentLink] : [];

/**
 * 도식은 본문 뒤에 온다. 독자가 논증을 먼저 읽고 정리용으로 보게 하기 위해서다.
 * 목차에도 같은 순서로 넣어, 목차가 페이지의 실제 구조와 어긋나지 않게 한다.
 */
const diagramSections: ExtraSection[] =
	slug === 'internal-issue-management'
		? [
				{ id: 'realtime-boundary', title: '실시간 갱신의 트랜잭션 경계' },
				{ id: 'migration-boundary', title: '데이터 이전의 실패 경계' },
			]
		: slug === 'admin-renewal'
			? [{ id: 'process-diagram', title: '구현 과정' }]
			: slug === 'device-detection'
				? [{ id: 'detection-flow', title: '판별 과정' }]
				: [];
---

<Layout
	title={`${data.title} — ${site.name}`}
	description={isUnconfirmed(data.summary) ? undefined : data.summary}
	ogType="article"
>
	<header>
		<h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
			{data.title}
		</h1>
		<p class="mt-3 text-sm text-muted">{data.category}</p>
	</header>

	<DetailSection id="overview" title="요약">
		<div class="flex flex-col gap-6">
			<MetaList items={meta} />
			{
				!isUnconfirmed(data.summary) && (
					<p class="m-0 max-w-prose text-base leading-relaxed">{data.summary}</p>
				)
			}
			{data.highlights.length > 0 && (
				<LabeledList label="하이라이트" items={data.highlights} />
			)}
			{data.tech.length > 0 && (
				<p class="m-0 text-sm leading-relaxed text-muted">
					<span class="mr-3 font-medium text-foreground">기술</span>
					{data.tech.join(' · ')}
				</p>
			)}
			<a href="#case-detail" class="inline-flex min-h-11 items-center text-sm font-medium no-underline hover:underline">
				문제·판단·구현 과정 읽기
			</a>
		</div>
	</DetailSection>

	<TableOfContents headings={headings} extra={diagramSections} />

	<div id="case-detail" class="scroll-mt-8">
		<ArticleBody class="mt-16 sm:mt-20">
			<Content />
		</ArticleBody>
	</div>

	{
		slug === 'internal-issue-management' && (
			<>
				<DetailSection id="realtime-boundary" title="실시간 갱신의 트랜잭션 경계">
					<RealtimeBoundary />
				</DetailSection>
				<DetailSection id="migration-boundary" title="데이터 이전의 실패 경계">
					<MigrationBoundary />
				</DetailSection>
			</>
		)
	}
	{
		slug === 'admin-renewal' && (
			<DetailSection id="process-diagram" title="구현 과정">
				<AdminRenewalProcess />
			</DetailSection>
		)
	}
	{
		slug === 'device-detection' && (
			<DetailSection id="detection-flow" title="판별 과정">
				<DeviceDetectionFlow />
			</DetailSection>
		)
	}

	<PrevNextNav prev={prev} next={next} />

	{
		relatedLinks.length > 0 && (
			<DetailSection id="links" title="관련 링크">
				<RelatedLinks items={relatedLinks} />
			</DetailSection>
		)
	}
</Layout>
