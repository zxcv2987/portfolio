---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Prose from '../../components/Prose.astro';
import { site } from '../../config/site';
import { isUnconfirmed } from '../../lib/detail';

const entries = (await getCollection('case-studies')).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<Layout
	title={`Case Studies — ${site.name}`}
	description={`${site.name} ${site.role}의 대표 사례입니다. 운영 중 발견한 문제를 분석하고, 판단과 구현으로 연결한 과정을 확인할 수 있습니다.`}
>
	<header>
		<h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
			Case Studies
		</h1>
		<p class="mt-3 text-sm text-muted">
			운영 중 발견한 문제를 분석하고, 판단과 구현으로 연결한 대표 사례입니다.
		</p>
	</header>

	<div class="mt-10 space-y-10">
		{
			entries.map((entry) => {
				const meta = [entry.data.company, entry.data.period]
					.filter((part) => !isUnconfirmed(part))
					.join(' · ');

				return (
					<article class="border-t border-border-subtle pt-8 first:border-t-0 first:pt-0">
						<h2 class="text-lg font-bold tracking-tight">
							<a
								href={`/case-studies/${entry.data.slug}`}
								class="no-underline hover:underline"
							>
								{entry.data.title}
							</a>
						</h2>
						{meta && <p class="mt-1 text-sm text-muted">{meta}</p>}
						<Prose class="mt-2">
							<p>{entry.data.summary}</p>
						</Prose>
						{
							entry.data.highlights.length > 0 && (
								<div class="mt-4 border-l-2 border-border-subtle pl-4">
									<p class="text-sm font-medium">확인할 근거</p>
									<ul class="mt-1 list-disc space-y-1 pl-4 text-sm text-muted marker:text-border-subtle">
										{entry.data.highlights
											.filter((item) => !isUnconfirmed(item))
											.slice(0, 2)
											.map((item) => <li>{item}</li>)}
									</ul>
								</div>
							)
						}
						<a
							href={`/case-studies/${entry.data.slug}`}
							class="mt-4 inline-flex min-h-11 items-center text-sm font-medium no-underline hover:underline"
						>
							문제·판단·구현 과정 읽기
						</a>
					</article>
				);
			})
		}
	</div>
</Layout>
