---
import Layout from '../layouts/Layout.astro';
import Prose from '../components/Prose.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Metric from '../components/Metric.astro';
import MetricGroup from '../components/MetricGroup.astro';
import { site } from '../config/site';
---

<Layout title={`${site.nameEn} — ${site.role}`}>
	<section aria-labelledby="intro-heading">
		<p class="text-sm font-medium text-muted">{site.role}</p>
		<h1
			id="intro-heading"
			class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl"
		>
			{site.name}
		</h1>
		<Prose class="mt-6">
			<p>{site.headline}</p>
			<p class="text-muted">
				관리자 시스템의 빌드 시간을 5~10분에서 약 30초로 단축했으며, 실제 사용자
				환경에서 발생한 기기 판별 문제를 Sentry 데이터로 추적하고 여러 브라우저
				신호를 조합해 해결했습니다.
			</p>
		</Prose>
	</section>

	<section aria-labelledby="highlights-heading" class="mt-16 sm:mt-20">
		<SectionTitle id="highlights-heading">핵심 성과</SectionTitle>
		<MetricGroup class="mt-6">
			<Metric
				value="약 30초"
				label="관리자 시스템 빌드 시간"
				context="기존 5~10분"
			/>
			<Metric value="90~95%" label="개발 피드백 속도 개선" />
		</MetricGroup>
	</section>

	<section aria-labelledby="sections-heading" class="mt-16 sm:mt-20">
		<SectionTitle id="sections-heading">더 보기</SectionTitle>
		<Prose class="mt-4">
			<p class="text-muted">
				경력과 상세 사례는 각 섹션에서 확인할 수 있습니다.
			</p>
		</Prose>
	</section>
</Layout>
