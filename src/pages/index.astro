---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Prose from '../components/Prose.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Metric from '../components/Metric.astro';
import MetricGroup from '../components/MetricGroup.astro';
import { site } from '../config/site';
import { getProfile, getSkillGroups } from '../lib/profile';
import { isLiveService, linkItemsFromRecord } from '../lib/detail';

const isUnconfirmed = (value?: string) => !value || value.includes('TODO');

const homeUrl = new URL('/', Astro.site ?? Astro.url).toString();
const homeDescription = `${site.name}(${site.nameEn}) ${site.role} 포트폴리오입니다. ${site.headline}. 대표 사례, 프로젝트, 경력과 기술을 한 페이지에서 확인할 수 있습니다.`;

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': `${homeUrl}#person`,
			name: site.name,
			alternateName: site.nameEn,
			jobTitle: site.role,
			description: site.headline,
			url: homeUrl,
			email: `mailto:${site.email}`,
			sameAs: [site.github],
		},
		{
			'@type': 'WebSite',
			'@id': `${homeUrl}#website`,
			name: `${site.name} — ${site.role}`,
			url: homeUrl,
			inLanguage: 'ko-KR',
			description: homeDescription,
			author: { '@id': `${homeUrl}#person` },
		},
	],
};

const profile = getProfile();

const skillGroups = getSkillGroups(profile);

const experienceEntries = (await getCollection('experience')).sort(
	(a, b) => a.data.order - b.data.order,
);
const caseStudyEntries = (await getCollection('case-studies')).sort(
	(a, b) => a.data.order - b.data.order,
);
const projectEntries = (await getCollection('projects')).sort(
	(a, b) => a.data.order - b.data.order,
);

const featuredCaseStudies = caseStudyEntries.filter(
	(entry) => entry.data.featured,
);
const featuredProjects = projectEntries.filter(
	(entry) => entry.data.featured,
);
const otherProjects = projectEntries.filter(
	(entry) => !entry.data.featured,
);
---

<Layout
	title={`${site.nameEn} — ${site.role}`}
	description={homeDescription}
	structuredData={structuredData}
>
	<section aria-labelledby="intro-heading">
		<p class="text-sm font-medium text-muted">{site.role}</p>
		<h1
			id="intro-heading"
			class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl"
		>
			{site.name}
		</h1>
		<Prose class="mt-6">
			<p>{site.headline}</p>
		</Prose>
	</section>

	<section aria-labelledby="metrics-heading" class="mt-16 sm:mt-20">
		<SectionTitle id="metrics-heading">대표 수치</SectionTitle>
		<MetricGroup class="mt-6">
			<Metric
				value="약 30초"
				label="관리자 시스템 빌드 시간"
				context="기존 약 10분"
			/>
			<Metric value="약 95%" label="개발 피드백 속도 개선" />
			<Metric
				value="2,011건"
				label="이슈·댓글·첨부 운영 이전"
				context="이슈 관리 시스템, 클라이언트 실사용 중"
			/>
		</MetricGroup>
	</section>

	<section aria-labelledby="experience-heading" class="mt-16 sm:mt-20">
		<SectionTitle id="experience-heading">회사 경력</SectionTitle>
		<div class="mt-6 space-y-8">
			{
				experienceEntries.map((entry) => {
					const meta = [
						entry.data.role,
						entry.data.employment_type,
						isUnconfirmed(entry.data.period) ? undefined : entry.data.period,
					]
						.filter((part) => part !== undefined)
						.join(' · ');

					return (
						<article>
							<h3 class="text-base font-bold tracking-tight sm:text-lg">
								{entry.data.company}
							</h3>
							<p class="mt-1 text-sm text-muted">{meta}</p>
						</article>
					);
				})
			}
		</div>
	</section>

	<section aria-labelledby="case-studies-heading" class="mt-16 sm:mt-20">
		<SectionTitle id="case-studies-heading">대표 사례</SectionTitle>
		<div class="mt-6 space-y-8">
			{
				featuredCaseStudies.map((entry) => {
					const meta = [entry.data.company, entry.data.period]
						.filter((part) => !isUnconfirmed(part))
						.join(' · ');

					return (
						<article>
							<h3 class="text-base font-bold tracking-tight sm:text-lg">
								<a
									href={`/case-studies/${entry.data.slug}`}
									class="no-underline hover:underline"
								>
									{entry.data.title}
								</a>
							</h3>
							{meta && <p class="mt-1 text-sm text-muted">{meta}</p>}
							<Prose class="mt-2">
								<p>{entry.data.summary}</p>
							</Prose>
						</article>
					);
				})
			}
		</div>
	</section>

	<section aria-labelledby="projects-heading" class="mt-16 sm:mt-20">
		<SectionTitle id="projects-heading">대표 프로젝트</SectionTitle>
		<div class="mt-6 space-y-8">
			{
				featuredProjects.map((entry) => {
					const meta = [entry.data.category, entry.data.period]
						.filter((part) => !isUnconfirmed(part))
						.join(' · ');
					const links = entry.data.links
						? linkItemsFromRecord(entry.data.links)
						: [];

					return (
						<article>
							<h3 class="text-base font-bold tracking-tight sm:text-lg">
								<a
									href={`/projects/${entry.data.slug}`}
									class="no-underline hover:underline"
								>
									{entry.data.title}
								</a>
								{isLiveService(entry.data) && (
									<span class="ml-2 rounded-full border border-border-subtle px-2 py-0.5 align-middle text-xs font-medium text-muted">
										운영 중
									</span>
								)}
							</h3>
							{meta && <p class="mt-1 text-sm text-muted">{meta}</p>}
							<Prose class="mt-2">
								<p>{entry.data.summary}</p>
							</Prose>
							{links.length > 0 && (
								<ul class="mt-3 flex list-none flex-wrap gap-x-4 gap-y-1 p-0 text-sm">
									{links.map((link) => (
										<li>
											<a
												href={link.href}
												rel={link.external ? 'noopener noreferrer' : undefined}
												target={link.external ? '_blank' : undefined}
												class="no-underline hover:underline"
											>
												{link.label}
											</a>
										</li>
									))}
								</ul>
							)}
						</article>
					);
				})
			}
		</div>
	</section>

	<section aria-labelledby="other-projects-heading" class="mt-16 sm:mt-20">
		<SectionTitle id="other-projects-heading">기타 프로젝트</SectionTitle>
		<ul class="mt-6 list-none divide-y divide-border-subtle p-0">
			{
				otherProjects.map((entry) => {
					const meta = [entry.data.category, entry.data.period]
						.filter((part) => !isUnconfirmed(part))
						.join(' · ');

					return (
						<li class="py-5 first:pt-0 last:pb-0">
							<h3 class="text-base font-bold tracking-tight">
								<a
									href={`/projects/${entry.data.slug}`}
									class="no-underline hover:underline"
								>
									{entry.data.title}
								</a>
								{isLiveService(entry.data) && (
									<span class="ml-2 rounded-full border border-border-subtle px-2 py-0.5 align-middle text-xs font-medium text-muted">
										운영 중
									</span>
								)}
							</h3>
							{meta && <p class="mt-1 text-sm text-muted">{meta}</p>}
							<p class="mt-2 text-sm">{entry.data.summary}</p>
						</li>
					);
				})
			}
		</ul>
	</section>

	<section aria-labelledby="skills-heading" class="mt-16 sm:mt-20">
		<SectionTitle id="skills-heading">기술</SectionTitle>
		{
			skillGroups.length > 0 && (
				<div class="mt-6 grid gap-x-12 gap-y-8 sm:grid-cols-2">
					{skillGroups.map((group) => (
						<div>
							<h3 class="text-base font-bold tracking-tight">
								{group.label}
							</h3>
							<p class="mt-2 text-sm text-muted">{group.items.join(', ')}</p>
						</div>
					))}
				</div>
			)
		}
	</section>
</Layout>
